{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "discogs": {
      "type": "local",
      "enabled": true,
      "command": [
        "dnx",
        "discogs-mcp",
        "--yes"
      ],
      "environment": {
        "DISCOGS_TOKEN": "YOUR_DISCOGS_TOKEN_HERE",
        "DISCOGS_USER_AGENT": "YourAppName/0.1 (+https://yoursite.example)"
      }
    }
  }
}
